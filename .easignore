# Ignore local IDE settings and background lock files
.vs/
*.slnx
*.suo
*.user
*.vsidx

# Standard node and build ignores
node_modules/
.expo/
dist/

# Native projects are generated by EAS via prebuild from app.json.
# They are local `expo run` artifacts (gitignored) and must NOT be uploaded,
# otherwise EAS skips prebuild and builds a stale native project — dropping
# app.json plugin config (e.g. notifee extraMavenRepos) and bloating the upload.
android/
ios/