# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
eas.json

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
# Gradle output inside the local native modules. /android above is root-anchored
# and does not reach these, so a local build would otherwise stage its artifacts.
modules/*/android/build/
modules/*/android/.gradle/

# IDE / Editor configurations
.idea/
.vs/
.claude/
CLAUDE.md
AGENTS.md
*.apk
