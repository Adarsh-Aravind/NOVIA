{
  "expo": {
    "name": "NOVIA",
    "slug": "noviris",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cat.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": "2.0.0",
    "updates": {
      "url": "https://u.expo.dev/928a233f-606a-412b-9b2a-6c9e57eba586",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/cat2.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [ "audio", "fetch", "processing" ]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.critical-alerts": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/cat.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "navigationBar": {
        "backgroundColor": "#00000000",
        "barStyle": "light"
      },
      "package": "com.iitznova.novia",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.TURN_SCREEN_ON",
        "android.permission.DISABLE_KEYGUARD",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": { "favicon": "./assets/favicon.png" },
    "extra": { "eas": { "projectId": "928a233f-606a-412b-9b2a-6c9e57eba586" } },
    "plugins": [
      "./plugins/withAlarmFullScreen",
      "expo-audio",
      [
        "expo-notifications",
        {
          "sounds": [ "./assets/sounds/alarm.wav" ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NOVIA uses your location so you can share where you are with your partner."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ]
  }
}
