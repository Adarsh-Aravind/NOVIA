# NOVIA Environment Variables Template
# Copy this file to .env and configure with your active Supabase credentials

EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Groq API key for the ideas generator (https://console.groq.com)
EXPO_PUBLIC_GROQ_API_KEY=your-groq-api-key
